# Copy this file to .env and fill in your Sanity project details.
# Get these from https://www.sanity.io/manage after creating a project.

# Your Sanity project ID (e.g. abc12345)
SANITY_PROJECT_ID=
# Your Sanity dataset (usually "production")
SANITY_DATASET=production

# Your deployed site URL, used for SEO / sitemap (Vercel sets its own too)
SITE_URL=https://your-site.vercel.app

# Studio access password: /studio is locked behind this. Set it in your
# Vercel project env vars too, or the studio will be unreachable in prod
# (fail closed). In local dev it's not required and the studio opens freely.
STUDIO_PASSWORD=

# Draft preview (optional): set BOTH to render unpublished edits live at
# perspective 'previews'. Keep the flag off in production. Get a read-only
# token from Sanity → Manage → API → Tokens (role: Viewer).
PUBLIC_SANITY_VISUAL_EDITING_ENABLED=false
SANITY_API_READ_TOKEN=

# Planner form backend (optional but recommended): a WRITE token lets the
# /api/planner endpoint save form inquiries as Sanity documents, viewable in
# the Studio under "Inquiries". Get it from Sanity → Manage → API → Tokens
# (role: Editor/Contributor). Without it, the form falls back to mailto.
SANITY_API_WRITE_TOKEN=

# Planner email notifications (optional): with a Resend API key plus the
# recipient address, every saved inquiry emails the owner. The sender must
# be verified in your Resend account; CONTACT_NOTIFY_FROM defaults to
# Resend's sandbox address. Without these, submissions are still saved.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
CONTACT_NOTIFY_FROM=

# Planner rate limiting (optional): connect a Vercel KV store from Vercel
# → Storage and Vercel injects these automatically. Makes the per-IP
# submission cap (3 per 15 min) global across serverless instances.
# Without KV the cap still applies per instance.
KV_REST_API_URL=
KV_REST_API_TOKEN=
