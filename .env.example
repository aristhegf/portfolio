# Copy this file to .env and fill in your Sanity project details.
# Get these from https://www.sanity.io/manage after creating a project.

# Your Sanity project ID (e.g. abc12345)
SANITY_PROJECT_ID=
# Your Sanity dataset (usually "production")
SANITY_DATASET=production

# Your deployed site URL, used for SEO / sitemap (Vercel sets its own too)
SITE_URL=https://your-site.vercel.app

# Draft preview (optional): set BOTH to render unpublished edits live at
# perspective 'previews'. Keep the flag off in production. Get a read-only
# token from Sanity → Manage → API → Tokens (role: Viewer).
PUBLIC_SANITY_VISUAL_EDITING_ENABLED=false
SANITY_API_READ_TOKEN=
