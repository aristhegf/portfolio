---
import Layout from '../layouts/Layout.astro';
import Prose from '../components/Prose.astro';
import { getSettings, urlFor } from '../lib/sanity';

const settings = await getSettings();
const socials = settings?.socials || [];
const profile = settings?.profileImage ? urlFor(settings.profileImage, 900) : undefined;
---

<Layout title="About" description={settings?.tagline} settings={settings}>
  <section class="section">
    <div class="container">
      <p class="meta reveal" style="--i: 0">About</p>
      <h1 class="display reveal" style="--i: 1; margin-top: 1.2rem; max-width: 18ch">
        {settings?.name || 'Portfolio'}
      </h1>

      {profile && (
        <div class="profile reveal" style="--i: 1">
          <img src={profile} alt={settings?.name ? `Portrait of ${settings.name}` : 'Portrait'} />
        </div>
      )}

      <div class="detail-meta reveal" style="--i: 2; margin-top: 2.4rem">
        {settings?.location && (
          <span class="meta"><strong>Based in</strong> — {settings.location}</span>
        )}
        <span class="meta">
          <strong>Availability</strong> —{' '}
          {settings?.available === false ? 'Booked' : 'Open to new work'}
        </span>
        {settings?.email && (
          <span class="meta"><strong>Contact</strong> — {settings.email}</span>
        )}
      </div>

      {
        settings?.bio && (
          <div class="mt-l reveal" style="--i: 2">
            <Prose value={settings.bio} />
          </div>
        )
      }

      {socials.length > 0 && (
        <div class="mt-l reveal" style="--i: 3">
          <p class="meta" style="margin-bottom: 1rem">Elsewhere</p>
          <div class="filters">
            {socials.map((s) => (
              <a class="chip" href={s.url} target="_blank" rel="noopener noreferrer">
                {s.label}
              </a>
            ))}
          </div>
        </div>
      )}

      {settings?.email && (
        <div class="mt-l reveal" style="--i: 4">
          <a class="btn" href={`mailto:${settings.email}`}>
            Get in touch
          </a>
        </div>
      )}
    </div>
  </section>
</Layout>
