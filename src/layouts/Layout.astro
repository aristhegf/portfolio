---
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Effects from '../components/Effects.astro';
import { ClientRouter } from 'astro:transitions';
import { VisualEditing } from '@sanity/astro/visual-editing';
import { getSettings, type Settings } from '../lib/sanity';

// Visual Editing overlays only mount when this flag is on; otherwise the
// component renders nothing and no React runtime ships to the page.
const visualEditingEnabled = import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === 'true';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  settings?: Settings | null;
}

const {
  title,
  description = 'A selected collection of work across video, design, writing, and the web.',
  noindex = false,
  settings: settingsProp,
} = Astro.props;

const settings = settingsProp !== undefined ? settingsProp : await getSettings();
const siteName = settings?.name || 'Portfolio';
const fullTitle = title ? `${title} — ${siteName}` : siteName;
// Canonical/OG should point at the configured site (SITE_URL), not the request
// origin — so dev previews and filtered URLs (e.g. /work?category=…) resolve
// to clean production URLs. Falls back to the request URL when site is unset.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
  </head>
  <body>
    <ClientRouter />
    <Effects />
    <Nav settings={settings} />
    <main>
      <slot />
    </main>
    <Footer settings={settings} />

    <script>
      /* Scroll reveals for any .reveal element. Re-runs on every view
         transition (astro:page-load) so newly swapped elements animate. */
      const initReveals = () => {
        const els = document.querySelectorAll('.reveal');
        if ('IntersectionObserver' in window && els.length) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  const el = entry.target as HTMLElement;
                  // Apply the stagger inline so it wins over any competing
                  // `transition` shorthand (e.g. .filter-result on /work),
                  // then clear it once the reveal finishes so later
                  // transitions — like the work filters' fades — aren't
                  // delayed.
                  const i = el.style.getPropertyValue('--i').trim();
                  if (i) {
                    el.style.transitionDelay = `calc(${i} * 70ms)`;
                    const clearDelay = () => el.style.removeProperty('transition-delay');
                    el.addEventListener('transitionend', clearDelay, { once: true });
                    el.addEventListener('transitioncancel', clearDelay, { once: true });
                  }
                  el.classList.add('is-visible');
                  io.unobserve(el);
                }
              }
            },
            { threshold: 0.1, rootMargin: '0px 0px -8% 0px' },
          );
          els.forEach((el) => io.observe(el));
        } else {
          els.forEach((el) => el.classList.add('is-visible'));
        }
      };
      document.addEventListener('astro:page-load', initReveals);
    </script>
    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
    <VisualEditing enabled={visualEditingEnabled} zIndex={1000} />
  </body>
</html>
