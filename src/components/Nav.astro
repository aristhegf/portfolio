---
import type { Settings } from '../lib/sanity';

interface Props {
  settings: Settings | null;
}

const { settings } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/work', label: 'Work' },
  { href: '/writing', label: 'Writing' },
  { href: '/about', label: 'About' },
];
---

<header class="nav">
  <div class="container nav__inner">
    <a class="nav__brand" href="/">
      {settings?.name || 'Portfolio'}<span class="dot">.</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {
        links.map((link) => (
          <a
            class="nav__link"
            href={link.href}
            aria-current={path.startsWith(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        aria-label="Toggle day and night mode"
      >
        <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5" />
          <path
            d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </svg>
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M20.2 14.5A8.6 8.6 0 0 1 9.5 3.8a8.6 8.6 0 1 0 10.7 10.7Z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"
          />
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('theme-toggle');
  if (!toggle) throw new Error('Theme toggle button not found');
  toggle.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch (e) {}
  });
</script>
