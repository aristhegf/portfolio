---
import ContactIcons from './ContactIcons.astro';
import type { Settings } from '../lib/sanity';

interface Props {
  settings: Settings | null;
}

const { settings } = Astro.props;
// The admin studio and Instagram are private — never surface them in the
// footer even if they're configured in the Studio settings.
const socials = (settings?.socials || []).filter((s) => !/instagram/i.test(s.label));
// Strip stega/zero-width characters the draft-preview encoding can inject
// into string values — they'd otherwise explode the per-letter animation.
const brand = (settings?.name || 'Portfolio').replace(/[\u200B-\u200F\u2060\u2061\u2062\u2063\uFEFF]/g, '');
const location = settings?.location || 'Remote';
// Initials for the OKC-style social boxes — "Behance" → "BE".
const initials = (label: string) =>
  label
    .split(/\s+/)
    .filter(Boolean)
    .map((w) => w[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

<footer class="footer" role="contentinfo">
  <div class="container footer__inner">
    <div class="footer__grid">
      <div class="footer__brand-col">
        <a
          class="footer__brand"
          href="/"
          aria-label={brand}
          style={`--brand-len: ${brand.length}`}
        >
          {
            Array.from(brand).map((ch, i) => (
              <span class="brand-letter" style={`--li: ${i}`}>
                {ch === ' ' ? '\u00A0' : ch}
              </span>
            ))
          }
          <span class="brand-dot" aria-hidden="true">.</span>
        </a>
        {settings?.tagline && <p class="footer__tagline">{settings.tagline}</p>}
      </div>

      <div class="footer__col">
        <address class="footer__address">{location}</address>
      </div>

      <div class="footer__col">
        <nav class="footer__links" aria-label="Footer">
          <a class="shine" href="/work">Work</a>
          <a class="shine" href="/writing">Writing</a>
          <a class="shine" href="/about">About</a>
          <a class="shine" href="/planner">Discuss the project</a>
        </nav>
      </div>

      <div class="footer__col footer__socials-col">
        <ContactIcons settings={settings} />
        {socials.length > 0 && (
          <div class="socials">
            {socials.map((s) => (
              <a
                class="socials__btn"
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                title={s.label}
                aria-label={s.label}
              >
                {initials(s.label)}
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</footer>
