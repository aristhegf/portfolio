---
// Decorative night-sky background, CSS-gated to dark mode (see .starfield
// rules in global.css). Kept deliberately dark, misty, and faint — the scene
// should whisper, not shout: a few stars through drifting fog, barely-there
// galaxy glows, a dim tilted orbit system, and the occasional faint meteor.
const STAR_COUNT = 40;

// Deterministic pseudo-random so the sky is stable across renders.
function rand(i: number, salt: number): number {
  const x = Math.sin(i * 127.1 + salt * 311.7) * 43758.5453;
  return x - Math.floor(x);
}

const stars = Array.from({ length: STAR_COUNT }, (_, i) => {
  const layer = i % 3;
  return {
    layer,
    left: `${(rand(i, 1) * 100).toFixed(2)}%`,
    top: `${(rand(i, 2) * 100).toFixed(2)}%`,
    // Far layers get smaller, dimmer stars — depth via size too.
    size: ((0.6 + rand(i, 3) * 1.6) * (0.7 + layer * 0.35)).toFixed(1),
    delay: (rand(i, 4) * 9).toFixed(2),
    duration: (4 + rand(i, 5) * 8).toFixed(1),
  };
});

const layers = [0, 1, 2].map((l) => stars.filter((s) => s.layer === l));

const planets = [
  { orbit: 18, dur: 55, size: 4, tint: '#cfe0ea', glow: 'rgba(207, 224, 234, 0.35)' },
  { orbit: 32, dur: 85, size: 5, tint: '#cfc4b2', glow: 'rgba(207, 196, 178, 0.3)' },
  { orbit: 46, dur: 130, size: 3, tint: '#b9b6cf', glow: 'rgba(185, 182, 207, 0.3)' },
];
---

<div class="starfield" aria-hidden="true">
  <div class="starfield__galaxy starfield__galaxy--far"></div>
  <div class="starfield__galaxy starfield__galaxy--near"></div>

  {
    layers.map((layer, li) => (
      <div class={`starfield__stars starfield__stars--${li + 1}`}>
        {layer.map((s) => (
          <span
            style={`left:${s.left};top:${s.top};width:${s.size}px;height:${s.size}px;animation-delay:${s.delay}s;animation-duration:${s.duration}s`}
          ></span>
        ))}
      </div>
    ))
  }

  <div class="starfield__mist"></div>

  <div class="starfield__system">
    <div class="starfield__system-plane">
      <div class="starfield__sun"></div>
      {planets.map((p, i) => (
        <div
          class={`starfield__orbit starfield__orbit--${i}`}
          style={`width:${p.orbit * 2}%;height:${p.orbit * 2}%;left:${50 - p.orbit}%;top:${50 - p.orbit}%;animation-duration:${p.dur}s`}
        >
          <span
            class="starfield__planet"
            style={`width:${p.size}px;height:${p.size}px;background:${p.tint};box-shadow:0 0 ${p.size * 2}px ${p.glow}`}
          ></span>
        </div>
      ))}
    </div>
  </div>

  <div class="starfield__meteor starfield__meteor--1"></div>
  <div class="starfield__meteor starfield__meteor--2"></div>
  <div class="starfield__meteor starfield__meteor--3"></div>

  <div class="starfield__fog"></div>
</div>
